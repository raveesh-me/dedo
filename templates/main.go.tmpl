// Command {{.Name}} serves {{.Service}} over Connect, gRPC, REST and MCP.
package main

import (
	"context"
	"log/slog"
	"net/http"
	"os"
{{- if .Tenancy}}
	"slices"
{{- end}}
	"strings"

	"connectrpc.com/connect/v2"
	"connectrpc.com/connect/v2/connecthttp"
	"connectrpc.com/connect/v2/connectinprocess"
	"connectrpc.com/validate"
	"connectrpc.com/vanguard"
	"github.com/modelcontextprotocol/go-sdk/mcp"
	"github.com/raveesh-me/dedo/flowid"
	"github.com/raveesh-me/dedo/interceptor"
	"github.com/raveesh-me/dedo/mcp/mcpserver"
	"github.com/raveesh-me/dedo/policy"

	"{{.Module}}/docs"
	{{.GoPkg}} "{{.GoImport}}"
	"{{.GoImport}}/{{.GoPkg}}connect"
)

func main() {
	log := slog.New(slog.NewJSONHandler(os.Stderr, nil))
	handler, err := newHandler(log)
	if err != nil {
		log.Error("startup failed", "error", err)
		os.Exit(1)
	}
	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":8080"
	}
	protocols := new(http.Protocols)
	protocols.SetHTTP1(true)
	protocols.SetUnencryptedHTTP2(true) // gRPC clients without TLS
	log.Info("listening", "addr", addr)
	server := &http.Server{Addr: addr, Handler: handler, Protocols: protocols}
	if err := server.ListenAndServe(); err != nil {
		log.Error("server stopped", "error", err)
		os.Exit(1)
	}
}

func newHandler(log *slog.Logger) (http.Handler, error) {
	// The API: scopes and policy come from the .proto, not from handlers.
	table, err := policy.Build({{.GoPkg}}connect.{{.Service}}Name)
	if err != nil {
		return nil, err
	}
	guard, err := interceptor.New(interceptor.Config{
		Table:         table,
		Scopes:        scopesFromContext,
		EnforceScopes: true,
{{- if .Tenancy}}
		Tenants:       tenantAllowed,
{{- end}}
		Log:           log,
	})
	if err != nil {
		return nil, err
	}
	// The interceptors run for every transport below, in order: flow IDs,
	// auth, the declared contract (scopes, headers, error audit), then the
	// buf.validate rules.
	server := connect.NewServer(flowid.Interceptor(), auth, guard, validate.NewServerInterceptor())
	// newServer returns your implementation of {{.GoPkg}}connect.{{.Service}}Handler.
	{{.GoPkg}}connect.Register{{.Service}}Handler(server, newServer())

	mux := http.NewServeMux()
	// Connect, gRPC and gRPC-Web, then REST from the google.api.http bindings.
	connecthttp.Mount(mux, server)
	if err := vanguard.Mount(mux, server); err != nil {
		return nil, err
	}

	// MCP: every RPC is a tool, as protoc-gen-dedo-mcp generated it, called
	// in-process on the same server with the caller's token.
	tools := mcp.NewServer(&mcp.Implementation{Name: "{{.Name}}", Version: "v1"}, nil)
	if err := mcpserver.AddTools(tools, connect.NewClient(connectinprocess.New(server)), {{.GoPkg}}.{{.Service}}MCPTools()...); err != nil {
		return nil, err
	}

	mux.Handle("GET /openapi.json", docs.Spec())
	mux.Handle("GET /docs", docs.Page())
	// Cross-origin protection: the MCP transport requires an Origin check.
	mux.Handle("/mcp", flowid.Middleware(http.NewCrossOriginProtection().Handler(mcp.NewStreamableHTTPHandler(
		func(*http.Request) *mcp.Server { return tools },
		&mcp.StreamableHTTPOptions{Stateless: true, JSONResponse: true}))))
	return mux, nil
}

// devTokens stands in for real token verification. Replace auth with your
// identity platform's token check before shipping.
{{- if not .AllScopes}}
// The proto declares no scopes yet, so every call is denied: add scopes to
// each RPC's dedo.v1.method option and run dedo init again.
{{- end}}
var devTokens = map[string][]string{
	"reader": { {{- range $i, $s := .ReadScopes}}{{if $i}}, {{end}}"{{$s}}"{{end -}} },
	"writer": { {{- range $i, $s := .AllScopes}}{{if $i}}, {{end}}"{{$s}}"{{end -}} },
}

{{- if .Tenancy}}

// devTenants stands in for your identity platform too: the {{.Tenancy}} each
// development token may act in, by ID.
var devTenants = map[string][]string{
	"reader": {"1"},
	"writer": {"1"},
}
{{- end}}

type scopesKey struct{}
{{- if .Tenancy}}

type tenantsKey struct{}
{{- end}}

// auth puts the scopes of the caller's bearer token in the call's context.
// As a server interceptor it covers Connect, gRPC, REST and MCP alike.
func auth(next connect.ServerFunc) connect.ServerFunc {
	return func(ctx context.Context, spec connect.Spec, stream connect.ServerStream) error {
		var token string
		if info, ok := connect.CallInfoForServerContext(ctx); ok {
			token, _ = strings.CutPrefix(info.RequestHeader().Get("Authorization"), "Bearer ")
		}
{{- if .Tenancy}}
		ctx = context.WithValue(ctx, tenantsKey{}, devTenants[token])
{{- end}}
		return next(context.WithValue(ctx, scopesKey{}, devTokens[token]), spec, stream)
	}
}

func scopesFromContext(ctx context.Context) []string {
	scopes, _ := ctx.Value(scopesKey{}).([]string)
	return scopes
}
{{- if .Tenancy}}

// tenantAllowed reports whether the caller may act in a tenant, by the ID in
// the request's resource name: "1" for {{.Tenancy}}/1/... The ID is "-" for
// a read across {{.Tenancy}} (AIP-159): grant it only to a caller who may
// see every one.
func tenantAllowed(ctx context.Context, tenant string) bool {
	tenants, _ := ctx.Value(tenantsKey{}).([]string)
	return slices.Contains(tenants, tenant)
}
{{- end}}
