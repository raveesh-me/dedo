// Command {{.Name}} serves {{range $i, $s := .Services}}{{if $i}}, {{end}}{{$s.Name}}{{end}} over Connect, gRPC, REST
// and MCP. It is the composition root: the only package that imports
// several modules, each from internal/<module>.
package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
{{- if .Tenancy}}
	"slices"
{{- end}}
	"strings"
	"syscall"
	"time"

	"connectrpc.com/connect/v2"
	"connectrpc.com/connect/v2/connecthttp"
	"connectrpc.com/connect/v2/connectinprocess"
	"connectrpc.com/validate"
	"connectrpc.com/vanguard"
	"github.com/modelcontextprotocol/go-sdk/mcp"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetrichttp"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp"
	"go.opentelemetry.io/otel/propagation"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.opentelemetry.io/otel/sdk/resource"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"

	"github.com/raveesh-me/dedo/flowid"
	"github.com/raveesh-me/dedo/interceptor"
	"github.com/raveesh-me/dedo/mcp/mcpserver"
	"github.com/raveesh-me/dedo/policy"
	"github.com/raveesh-me/dedo/telemetry"

	"{{.Module}}/docs"
{{- range .GenPkgs}}
	{{.GoPkg}} "{{.GoImport}}"
	"{{.GoImport}}/{{.GoPkg}}connect"
{{- end}}
{{- range .Mods}}
	{{if ne .Alias .Name}}{{.Alias}} {{end}}"{{$.Module}}/internal/{{.Name}}"
{{- end}}
)

// serviceName is service.name when OTEL_SERVICE_NAME does not set it.
const serviceName = "{{.Name}}"

func main() {
	// Every record logged with a call's context carries its trace_id and
	// span_id.
	log := slog.New(telemetry.NewLogHandler(slog.NewJSONHandler(os.Stderr, nil)))
	if err := run(log); err != nil {
		log.Error("server stopped", "error", err)
		os.Exit(1)
	}
}

// run serves until SIGINT or SIGTERM, then drains requests and flushes
// telemetry.
func run(log *slog.Logger) (err error) {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	shutdownTelemetry, err := setupTelemetry(ctx, log)
	if err != nil {
		return fmt.Errorf("startup failed: %w", err)
	}
	defer func() {
		flushCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		err = errors.Join(err, shutdownTelemetry(flushCtx))
	}()
	handler, err := newHandler(log)
	if err != nil {
		return fmt.Errorf("startup failed: %w", err)
	}
	addr := os.Getenv("ADDR")
	if addr == "" {
		addr = ":8080"
	}
	protocols := new(http.Protocols)
	protocols.SetHTTP1(true)
	protocols.SetUnencryptedHTTP2(true) // gRPC clients without TLS
	server := &http.Server{Addr: addr, Handler: handler, Protocols: protocols, ReadHeaderTimeout: 5 * time.Second}
	return serve(ctx, log, server)
}

// serve runs server until ctx is done, then shuts it down gracefully.
func serve(ctx context.Context, log *slog.Logger, server *http.Server) error {
	stopped := make(chan error, 1)
	go func() { stopped <- server.ListenAndServe() }()
	log.Info("listening", "addr", server.Addr)
	select {
	case err := <-stopped:
		return err
	case <-ctx.Done():
	}
	drainCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return server.Shutdown(drainCtx)
}

func newHandler(log *slog.Logger) (http.Handler, error) {
	// The API: scopes and policy come from the .proto, not from handlers.
	table, err := policy.Build(
{{- range .Services}}
		{{.GoPkg}}connect.{{.Name}}Name,
{{- end}}
	)
	if err != nil {
		return nil, err
	}
	guard, err := interceptor.New(interceptor.Config{
		Table:         table,
		Scopes:        scopesFromContext,
		EnforceScopes: true,
{{- if .Tenancy}}
		Tenants:       tenantAllowed,
{{- end}}
		Log:           log,
	})
	if err != nil {
		return nil, err
	}
	// OpenTelemetry: a span and an rpc.server.call.duration for every call,
	// continuing the caller's trace. setupTelemetry installed the SDK.
	observe, err := telemetry.NewServerInterceptor(telemetry.Config{})
	if err != nil {
		return nil, err
	}
	// The interceptors run for every transport below, in order: flow IDs,
	// telemetry, auth, the declared contract (scopes, headers, error audit),
	// then the buf.validate rules.
	server := connect.NewServer(flowid.Interceptor(), observe, auth, guard, validate.NewServerInterceptor())
	// Each module's handlers, from internal/<module>.
{{- range .Services}}
	{{.GoPkg}}connect.Register{{.Name}}Handler(server, {{.ModAlias}}.New{{.Type}}())
{{- end}}

	mux := http.NewServeMux()
	// Connect, gRPC and gRPC-Web, then REST from the google.api.http bindings.
	connecthttp.Mount(mux, server)
	if err := vanguard.Mount(mux, server); err != nil {
		return nil, err
	}

	// MCP: every RPC is a tool, as protoc-gen-dedo-mcp generated it, called
	// in-process on the same server with the caller's token.
	tools := mcp.NewServer(&mcp.Implementation{Name: "{{.Name}}", Version: "v1"}, nil)
	client := connect.NewClient(connectinprocess.New(server))
{{- range .Services}}
	if err := mcpserver.AddTools(tools, client, {{.GoPkg}}.{{.Name}}MCPTools()...); err != nil {
		return nil, err
	}
{{- end}}

	// MCP_ACCESS=authenticated answers only callers whose token you accept,
	// tool discovery included; public, the default, lets anyone list the
	// tools. Tool calls are checked by the interceptors above either way.
	endpoint, err := mcpserver.Guard(mcp.NewStreamableHTTPHandler(
		func(*http.Request) *mcp.Server { return tools },
		&mcp.StreamableHTTPOptions{Stateless: true, JSONResponse: true}),
		mcpserver.Access(os.Getenv("MCP_ACCESS")), authenticated)
	if err != nil {
		return nil, err
	}

	mux.Handle("GET /openapi.json", docs.Spec())
	mux.Handle("GET /docs", docs.Page())
	// The health probe. Health is the server's, never the API's: outside the
	// interceptors, so a probe needs no token (DEDO_NO_HEALTH_RPC).
	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	})
	// Cross-origin protection: the MCP transport requires an Origin check.
	// Inside it, a bridge in a container (Claude Desktop's, from dedo
	// local-mcp-claude) reaches a service on localhost as
	// host.containers.internal: AllowHosts lets that name through the SDK's
	// DNS rebinding protection, and MCP_ALLOWED_HOSTS replaces the list.
	endpoint = mcpserver.AllowHosts(endpoint, mcpserver.AllowedHosts(os.Getenv("MCP_ALLOWED_HOSTS")))
	// The MCP request gets a span, and its tool calls are children of it.
	endpoint = telemetry.Middleware(telemetry.Config{}, "/mcp", http.NewCrossOriginProtection().Handler(endpoint))
	mux.Handle("/mcp", flowid.Middleware(endpoint))
	return mux, nil
}

// devTokens stands in for real token verification. Replace auth with your
// identity platform's token check before shipping.
{{- if not .AllScopes}}
// The proto declares no scopes yet, so every call is denied: add scopes to
// each RPC's dedo.v1.method option and run dedo init again.
{{- end}}
var devTokens = map[string][]string{
	"reader": { {{- range $i, $s := .ReadScopes}}{{if $i}}, {{end}}"{{$s}}"{{end -}} },
	"writer": { {{- range $i, $s := .AllScopes}}{{if $i}}, {{end}}"{{$s}}"{{end -}} },
}

{{- if .Tenancy}}

// devTenants stands in for your identity platform too: the {{.Tenancy}} each
// development token may act in, by ID.
var devTenants = map[string][]string{
	"reader": {"1"},
	"writer": {"1"},
}
{{- end}}

type scopesKey struct{}
{{- if .Tenancy}}

type tenantsKey struct{}
{{- end}}

// bearer returns the token of an Authorization header value.
func bearer(authorization string) string {
	token, _ := strings.CutPrefix(authorization, "Bearer ")
	return token
}

// authenticated reports whether a request carries a token you accept, for
// MCP_ACCESS=authenticated. Replace it with your token check, like auth.
func authenticated(r *http.Request) bool {
	_, ok := devTokens[bearer(r.Header.Get("Authorization"))]
	return ok
}

// auth puts the scopes of the caller's bearer token in the call's context.
// As a server interceptor it covers Connect, gRPC, REST and MCP alike.
func auth(next connect.ServerFunc) connect.ServerFunc {
	return func(ctx context.Context, spec connect.Spec, stream connect.ServerStream) error {
		var token string
		if info, ok := connect.CallInfoForServerContext(ctx); ok {
			token = bearer(info.RequestHeader().Get("Authorization"))
		}
{{- if .Tenancy}}
		ctx = context.WithValue(ctx, tenantsKey{}, devTenants[token])
{{- end}}
		return next(context.WithValue(ctx, scopesKey{}, devTokens[token]), spec, stream)
	}
}

func scopesFromContext(ctx context.Context) []string {
	scopes, _ := ctx.Value(scopesKey{}).([]string)
	return scopes
}
{{- if .Tenancy}}

// tenantAllowed reports whether the caller may act in a tenant, by the ID in
// the request's resource name: "1" for {{.Tenancy}}/1/... The ID is "-" for
// a read across {{.Tenancy}} (AIP-159): grant it only to a caller who may
// see every one.
func tenantAllowed(ctx context.Context, tenant string) bool {
	tenants, _ := ctx.Value(tenantsKey{}).([]string)
	return slices.Contains(tenants, tenant)
}
{{- end}}

// setupTelemetry installs the OpenTelemetry SDK, which exports traces and
// metrics over OTLP (HTTP/protobuf). Only the standard OTEL_* environment
// variables configure it:
//
//	OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES   who is reporting
//	OTEL_EXPORTER_OTLP_ENDPOINT (and _HEADERS,    where to send, default
//	  _TIMEOUT, _COMPRESSION, per signal too)     http://localhost:4318
//	OTEL_TRACES_SAMPLER, OTEL_TRACES_SAMPLER_ARG  which traces to keep
//	OTEL_TRACES_EXPORTER, OTEL_METRICS_EXPORTER   otlp (default) or none
//	OTEL_PROPAGATORS                              tracecontext,baggage (default)
//	OTEL_SDK_DISABLED=true                        no SDK: every span is a no-op
//
// It returns the function that flushes and stops the SDK; call it on exit.
// On an error the service is meant to exit: what was installed stays
// global. This is the service's own code, not a dependency: change it
// freely, such as to add an exporter.
func setupTelemetry(ctx context.Context, log *slog.Logger) (func(context.Context) error, error) {
	// The propagator is set even without the SDK, so the caller's trace
	// context still reaches handlers, logs and outbound calls.
	propagator, err := propagatorFromEnv(os.Getenv("OTEL_PROPAGATORS"))
	if err != nil {
		return nil, err
	}
	otel.SetTextMapPropagator(propagator)
	if strings.EqualFold(os.Getenv("OTEL_SDK_DISABLED"), "true") {
		return func(context.Context) error { return nil }, nil
	}
	otel.SetErrorHandler(otel.ErrorHandlerFunc(func(err error) {
		log.Warn("telemetry export failed", "error", err)
	}))
	res, err := resource.New(ctx,
		resource.WithAttributes(attribute.String("service.name", serviceName)),
		resource.WithFromEnv(), // OTEL_SERVICE_NAME and OTEL_RESOURCE_ATTRIBUTES win
		resource.WithTelemetrySDK())
	if err != nil {
		return nil, fmt.Errorf("telemetry resource: %w", err)
	}
	var shutdowns []func(context.Context) error
	shutdown := func(ctx context.Context) error {
		var errs []error
		for _, stop := range shutdowns {
			errs = append(errs, stop(ctx))
		}
		return errors.Join(errs...)
	}
	if on, err := exporterOn("TRACES"); err != nil {
		return nil, err
	} else if on {
		exporter, err := otlptracehttp.New(ctx)
		if err != nil {
			return nil, fmt.Errorf("trace exporter: %w", err)
		}
		traces := sdktrace.NewTracerProvider(sdktrace.WithBatcher(exporter), sdktrace.WithResource(res))
		otel.SetTracerProvider(traces)
		shutdowns = append(shutdowns, traces.Shutdown)
	}
	if on, err := exporterOn("METRICS"); err != nil {
		return nil, errors.Join(err, shutdown(ctx))
	} else if on {
		exporter, err := otlpmetrichttp.New(ctx)
		if err != nil {
			return nil, errors.Join(fmt.Errorf("metric exporter: %w", err), shutdown(ctx))
		}
		metrics := sdkmetric.NewMeterProvider(sdkmetric.WithReader(sdkmetric.NewPeriodicReader(exporter)), sdkmetric.WithResource(res))
		otel.SetMeterProvider(metrics)
		shutdowns = append(shutdowns, metrics.Shutdown)
	}
	return shutdown, nil
}

// exporterOn reads OTEL_<SIGNAL>_EXPORTER, otlp or none, and checks that
// the signal's OTLP protocol is http/protobuf, the one exporter built in.
func exporterOn(signal string) (bool, error) {
	switch exporter := os.Getenv("OTEL_" + signal + "_EXPORTER"); exporter {
	case "none":
		return false, nil
	case "", "otlp":
	default:
		return false, fmt.Errorf("OTEL_%s_EXPORTER=%s: this service exports otlp or none", signal, exporter)
	}
	protocol := os.Getenv("OTEL_EXPORTER_OTLP_" + signal + "_PROTOCOL")
	if protocol == "" {
		protocol = os.Getenv("OTEL_EXPORTER_OTLP_PROTOCOL")
	}
	if protocol != "" && protocol != "http/protobuf" {
		return false, fmt.Errorf("OTLP protocol %s: this service exports http/protobuf; add the exporter for %s to main.go", protocol, protocol)
	}
	return true, nil
}

// propagatorFromEnv reads OTEL_PROPAGATORS: W3C Trace Context and Baggage
// by default.
func propagatorFromEnv(value string) (propagation.TextMapPropagator, error) {
	if value == "" {
		value = "tracecontext,baggage"
	}
	var propagators []propagation.TextMapPropagator
	for name := range strings.SplitSeq(value, ",") {
		switch strings.TrimSpace(name) {
		case "tracecontext":
			propagators = append(propagators, propagation.TraceContext{})
		case "baggage":
			propagators = append(propagators, propagation.Baggage{})
		case "none":
		default:
			return nil, fmt.Errorf("OTEL_PROPAGATORS: %q is not tracecontext, baggage or none", name)
		}
	}
	return propagation.NewCompositeTextMapPropagator(propagators...), nil
}
