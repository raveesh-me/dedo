# Include from a service Makefile: `include Makefile.api`.
# Deps are pinned in buf.lock; commit it. Add .tools/ to .gitignore.
#
# The lint plugin is pinned in go.mod as a Go tool, like the generators
# (go get -tool github.com/raveesh-me/dedo/lint/cmd/buf-plugin-dedo-lint@vX.Y.Z),
# and built into .tools/, where buf.yaml finds it. `dedo tools` does the same
# without make.
LINT_PLUGIN := github.com/raveesh-me/dedo/lint/cmd/buf-plugin-dedo-lint

.PHONY: tools api-update api-check api-generate

## tools: build the lint plugin pinned in go.mod into .tools/, again whenever go.mod changes
tools: .tools/buf-plugin-dedo-lint

.tools/buf-plugin-dedo-lint: go.mod go.sum
	go build -o $@ $(LINT_PLUGIN)

## api-update: move deps to their latest versions
api-update:
	buf dep update

## api-check: format, lint, and breaking changes against API_BASE
# The branch breaking changes are checked against. A new repository, or a
# base without protos yet, has nothing to break, so that check is skipped.
API_BASE ?= main

api-check: tools
	buf format --diff --exit-code
	buf lint
	@if git rev-parse --verify --quiet 'refs/heads/$(API_BASE)' >/dev/null && \
		git ls-tree -r --name-only '$(API_BASE)' | grep -q '\.proto$$'; then \
		echo "buf breaking --against '.git#branch=$(API_BASE)'"; \
		buf breaking --against '.git#branch=$(API_BASE)'; \
	else \
		echo "buf breaking: skipped; branch $(API_BASE) has no .proto files yet (set API_BASE to compare with another branch)"; \
	fi

api-generate:
	buf generate
