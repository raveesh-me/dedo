# Include from a service Makefile: `include Makefile.api`.
# Deps are pinned in buf.lock; commit it. Add .tools/ to .gitignore.
#
# The lint plugin's release is the options module's label in buf.yaml; dedo,
# pinned in go.mod as a Go tool, installs it into $GOBIN and copies it into
# .tools/, where buf.yaml finds it.
#
# dedo init names a target api-<name> instead when the service's Makefile
# already has one of these names.

.PHONY: run generate check test tools api-update

## run: serve the API on Connect, gRPC, REST, /docs and /mcp
run:
	go run .

## generate: generate Go, Connect, MCP tools and the REST docs from the
## protos, then tidy go.mod; run it after every change to a .proto
generate:
	buf generate
	go mod tidy

## check: format, lint, and breaking changes against API_BASE; CI runs it
# The branch breaking changes are checked against. A new repository, or a
# base without protos yet, has nothing to break, so that check is skipped.
API_BASE ?= main

check: tools
	buf format --diff --exit-code
	buf lint
	@if git rev-parse --verify --quiet 'refs/heads/$(API_BASE)' >/dev/null && \
		git ls-tree -r --name-only '$(API_BASE)' | grep -q '\.proto$$'; then \
		echo "buf breaking --against '.git#branch=$(API_BASE)'"; \
		buf breaking --against '.git#branch=$(API_BASE)'; \
	else \
		echo "buf breaking: skipped; branch $(API_BASE) has no .proto files yet (set API_BASE to compare with another branch)"; \
	fi

## test: run the service's tests, the policy-table test among them
test:
	go test ./...

## tools: copy the lint plugin at buf.yaml's release into .tools/, fetch the house
## rules dedo.yaml imports, and check their overrides; run it after a clone, an
## upgrade, or a change to dedo.yaml's rules
tools:
	go tool dedo tools

## api-update: move deps to their latest versions
api-update:
	buf dep update

# Names that always exist, whatever the service's Makefile defines: CI can
# call these. Releases before v0.15.0 had only api-check and api-generate.
.PHONY: api-check api-generate api-test
api-check: check
api-generate: generate
api-test: test
