apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.Name}}
  namespace: {{.Name}}
spec:
  replicas: 1
  strategy:
    type: Recreate
  template:
    spec:
      # The service never calls the Kubernetes API: no token to steal.
      automountServiceAccountToken: false
      containers:
      - name: service
        # Images are loaded into kind, never pulled.
        imagePullPolicy: Never
