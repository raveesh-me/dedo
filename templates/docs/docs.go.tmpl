// Package docs serves the REST reference generated by protoc-gen-dedo-openapi.
package docs

import (
	_ "embed"
	"net/http"
)

//go:embed openapi.json
var spec []byte

//go:embed index.html
var page []byte

// Spec serves the OpenAPI document.
func Spec() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write(spec)
	})
}

// Page serves an interactive reference rendered from the OpenAPI document.
func Page() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "text/html; charset=utf-8")
		_, _ = w.Write(page)
	})
}
