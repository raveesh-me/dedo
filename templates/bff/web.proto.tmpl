syntax = "proto3";

package {{.Package}};

import "dedo/v1/options.proto";
import "google/api/annotations.proto";
import "google/api/field_behavior.proto";
import "google/api/resource.proto";

// A starter backend for frontend written by dedo init -bff. It serves only
// the frontend built from the same commit, so its RPCs follow the
// frontend's screens and change with them, with no breaking check. Read
// what each screen shows from the backend's API, as the caller.
service {{.Service}} {
  option (dedo.v1.service) = {
    // Only the frontend built from the same commit calls it. A published
    // module never declares this audience.
    audience: AUDIENCE_COMPONENT_INTERNAL
    owner_team: "{{.Team}}"
  };

  // GetPage returns one of the frontend's pages, with what it shows.
  rpc GetPage(GetPageRequest) returns (GetPageResponse) {
    option idempotency_level = NO_SIDE_EFFECTS;
    option (google.api.http) = {
      get: "{{.Root}}/web/v1/{name=pages/*}"
      response_body: "page"
    };
    option (dedo.v1.method) = {
      // The backend checks the caller's token for what the page reads;
      // declare the scopes of the RPCs it calls.
      scopes: "{{.Scope}}"
      errors: {
        reason: "PAGE_NOT_FOUND"
        code: NOT_FOUND
      }
      tool: {
        title: "Get a page"
        description: "Returns one page of the frontend by its resource name, such as pages/home."
        annotations: {
          read_only_hint: true
          open_world_hint: false
        }
      }
    };
  }
}

// Page is one of the frontend's pages.
message Page {
  option (google.api.resource) = {
    type: "{{.Domain}}/Page"
    pattern: "pages/{page}"
    singular: "page"
    plural: "pages"
  };
  option (dedo.v1.message) = {description: "One page of the frontend."};

  // The resource name, such as pages/home.
  string name = 1 [(google.api.field_behavior) = IDENTIFIER];
  // The page's title, as people see it.
  string title = 2 [(google.api.field_behavior) = OUTPUT_ONLY];
}

// GetPageRequest is the request of GetPage.
message GetPageRequest {
  option (dedo.v1.message) = {description: "Which page to get."};

  // The resource name of the page.
  string name = 1 [
    (google.api.field_behavior) = REQUIRED,
    (google.api.resource_reference) = {type: "{{.Domain}}/Page"}
  ];
}

// GetPageResponse is the response of GetPage.
message GetPageResponse {
  option (dedo.v1.message) = {description: "The requested page."};

  // The page.
  Page page = 1;
}
