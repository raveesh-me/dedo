# NestJS MCP server for the todo example. Build from this directory:
#   podman build -t localhost/nest-todo-mcp:dev .
FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --loglevel=error
COPY tsconfig.json nest-cli.json ./
COPY src ./src
RUN npx nest build && npm prune --omit=dev --no-audit --no-fund --loglevel=error

FROM docker.io/library/node:22-alpine
ENV NODE_ENV=production API_PORT=3100
WORKDIR /app
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3100
CMD ["node", "dist/main.js"]
